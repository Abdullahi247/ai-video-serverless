# Copy to .env and fill in (never commit .env)
#   cp .env.example .env
DOCKERHUB_USER=your_dockerhub_user
IMAGE_TAG=v1
RUNPOD_API_KEY=
# After endpoint is created — use the short id only (not the full URL):
#   RUNPOD_ENDPOINT_ID=5mngbsk6ip48fa
RUNPOD_ENDPOINT_ID=

# Then run a job:
#   ./scripts/run_job.py
#   ./scripts/run_job.py --prompt "your scene" --out out.mp4

# Worker runtime (also set these in the RunPod endpoint UI)
MODEL_BACKEND=wan22
MODEL_ID=Wan-AI/Wan2.2-TI2V-5B
TORCH_DTYPE=float16
VIDEO_FPS=16
