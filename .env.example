# Copy to .env and fill in (never commit .env)
DOCKERHUB_USER=your_dockerhub_user
IMAGE_TAG=v1
RUNPOD_API_KEY=
# After endpoint is created:
RUNPOD_ENDPOINT_ID=

# Worker runtime (also set these in the RunPod endpoint UI)
MODEL_BACKEND=wan22
MODEL_ID=Wan-AI/Wan2.2-TI2V-5B
TORCH_DTYPE=float16
VIDEO_FPS=16
